# ---------------------------------------------------------------------------
# ROZE storefront — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and is the only
# place real credentials belong. Both Next.js and the Prisma CLI read it —
# the CLI via `prisma.config.ts`, which loads `.env` then `.env.local`.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# TWO urls are required, and the difference matters.
#
# DATABASE_URL — transaction-mode POOLER, port 6543, with `pgbouncer=true`.
#   Used by the running application. The flag is required: PgBouncer in
#   transaction mode cannot keep prepared statements alive across a
#   connection, and Prisma must be told so.
#
# DIRECT_URL   — session-mode connection, port 5432.
#   Used by Prisma for migrations and introspection ONLY. Migrations need a
#   session-scoped connection and will fail through the transaction pooler.
#
# Find both under Project Settings → Database → Connection string in Supabase.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Every canonical URL, hreflang tag,
# sitemap entry and OG image URL is built from this one value.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp routing (E.164) ----------------------------------------------
# OPEN QUESTION: the client has not confirmed which of the three numbers is
# the WhatsApp line. These are the safest assumption — sales goes to the
# Google-verified showroom number, repairs to the first service number.
NEXT_PUBLIC_WHATSAPP_SALES="+962799000301"
NEXT_PUBLIC_WHATSAPP_SERVICE="+962796003040"

# --- Product image storage -------------------------------------------------
# Public hostname of the Supabase project, e.g. abcdefgh.supabase.co
# NOT a credential — it is the public host in every product image URL. It is an
# env var so the project ref is not hardcoded, and so both lib/product-image.ts
# and next.config.ts read the SAME value and cannot drift apart.
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=""

# --- Order notifications (server-side only) --------------------------------
# A cash-on-delivery order otherwise lands nowhere: written to the database
# with no human told. These wire up the email that tells the shop.
#
# If EITHER is missing the order still saves, a warning is logged, and
# `notifiedAt` stays null — run `npx tsx scripts/resend-unnotified.ts` after
# setting them to send the backlog. Notification never blocks an order.
#
# NEVER prefix these with NEXT_PUBLIC_ — that would ship the API key to the
# browser.
RESEND_API_KEY=""
ORDER_NOTIFICATION_EMAIL=""
# Optional. Resend requires a verified domain; defaults to their shared sender.
ORDER_NOTIFICATION_FROM=""
